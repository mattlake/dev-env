# macOS package manifest. Rebuild with:
#
#   brew tap felixkratz/formulae && brew trust felixkratz/formulae
#   brew bundle install --file=macos/Brewfile
#
# The trust step is required first: `brew bundle dump` silently omits formulae
# from untrusted taps, which is how sketchybar and borders went missing from an
# earlier version of this file.
#
# Not covered here, see install/macos.sh:
#   starship  -- installed out-of-band to /usr/local/bin, not a brew formula
#   zinit     -- git clone into ~/.local/share/zinit/zinit.git

